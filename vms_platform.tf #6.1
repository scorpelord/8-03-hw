### vms_resources variable

variable "vms_resources" {
  type = map(object({
    cores         = number
    memory        = number
    core_fraction = number
    disk_size     = number
    disk_type     = string
  }))
  default = {
    web = {
      cores         = 2
      memory        = 4
      core_fraction = 100
      disk_size     = 10
      disk_type     = "network-ssd"
    }
    db = {
      cores         = 2
      memory        = 2
      core_fraction = 20
      disk_size     = 10
      disk_type     = "network-ssd"
    }
  }
  description = "Resources configuration for VMs"
}

